# Copia este fichero a .env y ajusta los valores. .env NO se sube al repo.

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=cambia-esto

# Retención de datos en Prometheus
PROMETHEUS_RETENTION=15d

# --- Solo si usas el exporter opcional de la API (docker compose --profile api up -d) ---
# Infinity Portal > Global Settings > API Keys > New (servicio CloudGuard WAF, solo lectura)
WAF_API_KEY=
WAF_API_KEY_SECRET=
# Región del tenant: EU (por defecto) o US
# WAF_API_GW=https://cloudinfra-gw.portal.checkpoint.com
# WAF_API_GW=https://cloudinfra-gw-us.portal.checkpoint.com
