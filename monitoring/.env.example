# Copy this file to .env and adjust the values. .env is NOT committed.

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change-me

# Prometheus data retention
PROMETHEUS_RETENTION=15d

# --- Only if you use the optional API exporter (docker compose --profile api up -d) ---
# Infinity Portal > Global Settings > API Keys > New (CloudGuard WAF service, read-only)
WAF_API_KEY=
WAF_API_KEY_SECRET=
# Tenant region: EU (default) or US
# WAF_API_GW=https://cloudinfra-gw.portal.checkpoint.com
# WAF_API_GW=https://cloudinfra-gw-us.portal.checkpoint.com
